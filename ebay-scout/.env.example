# ===== eBay API (未設定ならモックデータで動作) =====
# https://developer.ebay.com/my/keys で発行
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_ENV=production | sandbox
EBAY_ENV=production
# 対象マーケットプレイス
EBAY_MARKETPLACE_ID=EBAY_US

# ===== 為替・コスト設定 =====
# 1 USD あたりの円 (未設定時 150)
USD_JPY_RATE=150
EBAY_FEE_RATE=0.15
SHIPPING_COST_JPY=2500
WAREHOUSE_FEE_JPY=800

# ===== 抽出条件 =====
MIN_PROFIT_MARGIN=20
MIN_PROFIT_JPY=3000

# ===== Slack (未設定なら標準出力にレポート表示) =====
SLACK_WEBHOOK_URL=

# モックを強制したい場合は 1
USE_MOCK=0
