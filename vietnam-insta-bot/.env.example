# ===== LLM（完全無料にするなら Gemini の無料枠を推奨）=====
# gemini | anthropic
LLM_PROVIDER=gemini
# https://aistudio.google.com/apikey で無料発行
GEMINI_API_KEY=
# 既定は常に最新の Flash を指すエイリアス（gemini-2.5-flash は 2026-12-01 で終了予定）
GEMINI_MODEL=gemini-flash-latest
# Evaluator だけ別モデルにしたい場合（未設定なら GEMINI_MODEL）
GEMINI_EVAL_MODEL=
# LLM_PROVIDER=anthropic の場合のみ（有料）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ===== 品質ループ =====
PASS_SCORE=85
MAX_LOOPS=3

# ===== 音声（edge-tts / 無料）=====
# vi-VN-HoaiMyNeural（女性） | vi-VN-NamMinhNeural（男性）
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=-10%
# edge-tts の実行コマンド（pip install edge-tts）
EDGE_TTS_BIN=edge-tts

# ===== Instagram Graph API =====
INSTAGRAM_ACCOUNT_ID=
PAGE_ACCESS_TOKEN=
GRAPH_API_VERSION=v23.0
# 画像の公開URLのベース（Graph API は公開URLの JPEG しか受け付けない）
# 例: https://raw.githubusercontent.com/<owner>/<repo>/main/vietnam-insta-bot/output
# GitHub Actions 上では未設定でも GITHUB_REPOSITORY と GITHUB_SHA から自動生成
MEDIA_BASE_URL=

# true にすると投稿 API を叩かずログだけ出す
DRY_RUN=false
