# 通常運用では LLM の API キーは不要です（Claude Code の定期実行が生成・評価します）。
# 以下は「API キーで完全自動にしたい場合」だけ設定（node src/index.js generate）
# LLM_PROVIDER=anthropic   # anthropic | gemini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# 画像に入れるアカウント名
BRAND_NAME=Tiếng Việt Lab

# ===== 品質ループ =====
PASS_SCORE=85
MAX_LOOPS=3

# ===== 音声（edge-tts / 無料）=====
# vi-VN-HoaiMyNeural（女性） | vi-VN-NamMinhNeural（男性）
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=-10%
# edge-tts の実行コマンド（pip install edge-tts）
EDGE_TTS_BIN=edge-tts

# ===== Instagram Graph API =====
INSTAGRAM_ACCOUNT_ID=
PAGE_ACCESS_TOKEN=
GRAPH_API_VERSION=v23.0
# 画像の公開URLのベース（Graph API は公開URLの JPEG しか受け付けない）
# 例: https://raw.githubusercontent.com/<owner>/<repo>/main/vietnam-insta-bot/output
# GitHub Actions 上では未設定でも GITHUB_REPOSITORY と GITHUB_SHA から自動生成
MEDIA_BASE_URL=

# true にすると投稿 API を叩かずログだけ出す
DRY_RUN=false
